# --- Mapping from the assignment's own .env.example naming ---
# This project uses LLM_API_KEY + LLM_BASE_URL instead of separate
# OPENAI_API_KEY / ANTHROPIC_API_KEY variables, so ANY OpenAI-compatible
# provider works through one code path (src/llm.py) rather than one
# hardcoded per provider — see README for why. LLM_MODEL and
# EMBEDDING_MODEL use the same names as the original template, so those
# two carry over unchanged. VECTOR_DB_URL / VECTOR_DB_API_KEY aren't
# needed — Qdrant runs embedded/local (QDRANT_STORAGE_ROOT below), no
# hosted vector DB. DATA_DIR from the original template is NOT currently
# wired into this code — data/tenant_a and data/tenant_b are hardcoded
# relative to the repo root (see scripts/ingest_all.py) — noted here
# honestly rather than silently ignored. LOG_LEVEL's closest equivalent
# here is TRACE (below) — a flow-tracing flag, not a general log level.

# --- LLM provider (swappable, OpenAI-compatible) ---
# Pick one provider by setting LLM_BASE_URL / LLM_API_KEY / LLM_MODEL.
# All three of these expose OpenAI-compatible chat-completions endpoints,
# so the same client code works for any of them.

# Groq (default — free tier, fast, reliable tool-calling)
# Note: llama-3.3-70b-versatile has a known Groq tool-calling formatting bug
# (emits "<function=...>" as plain text instead of a structured tool call).
# llama-3.1-8b-instant calls tools reliably but is occasionally flaky on
# answer quality (see README eval section). Groq periodically retires
# models — llama-4-scout-17b-16e-instruct and qwen3-32b, both winners of an
# earlier 4-model bake-off, were removed from Groq's lineup entirely between
# sessions. openai/gpt-oss-20b is the current default: re-verified directly
# against this project's actual submit_answer tool schema (not assumed) —
# correct answers, valid structured citations, and correctly refuses a
# cross-tenant account lookup without leaking the real balance.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# --- Alternative providers (uncomment to switch) ---
# Google Gemini (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# OpenRouter (free community models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Vector store ---
# Embedded/local Qdrant — no server needed. Each tenant gets its own
# on-disk storage directory for physical isolation (see README).
QDRANT_STORAGE_ROOT=./storage/qdrant

# --- Embeddings (local, free, no API key — via fastembed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# --- Reranking (pluggable, see src/reranker.py) ---
# Off by default: our real corpus is ~4-5 docs/tenant, too small for a
# cross-encoder reranker to reliably change top-k ordering — see
# eval/run_eval.py's on/off comparison for the measured evidence. Set to
# 1 to enable FlashRank (ms-marco-TinyBERT-L-2-v2, ~3MB, CPU-only, no
# torch — dependency footprint verified before adopting, see README).
RERANK_ENABLED=0

# --- Debug tracing ---
# Set to 1 to print [AGENT]/[RETRIEVER]/[VECTOR_STORE]/[INGEST] lines showing
# every flow branch live (tool-vs-answer decisions, tenant-pin overrides,
# isolation checks per hit). Off by default; the eval harness stays quiet.
TRACE=0

# --- Structured JSON audit log (src/audit.py) ---
# Separate from TRACE above: TRACE is human-readable console output for
# development; this is a durable, parseable, forensic record (one JSON
# line per Agent.ask() call in AUDIT_DIR/<date>.jsonl) — on by default,
# since a banking deployment would want this on even when TRACE is off.
AUDIT=1
AUDIT_DIR=./audit
